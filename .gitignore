# Visual Studio / MSBuild 构建中间产物
# 注意：不要忽略 dinput8-Release/ 整个目录，否则内部 dll 的例外规则不生效
dinput8-Debug/
# ⚠️ 必须写成 /Release/ 与 /Debug/（限定在仓库根）—— 裸 `Release/` 在 Windows 上
#    大小写不敏感，会连带命中 Rust 的 `sc3tools_*/target/release/`，
#    而**父目录一旦被忽略，其内部所有的 `!` 例外全部失效**。
#    实际后果：sc3tools_rndchs 的中文版 exe 长期无法入库
#    （git 报 "exists on disk, but not in 'HEAD'"），而 README 却把它列为现成工具。
/Release/
/Debug/
x64/
x86/
[Bb]in/
[Oo]bj/

# 构建产物
*.obj
*.tlog
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.exe
*.lastbuildstate
*.aps
*.VC.db
*.VC.opendb
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.cachefile
*.ipch

# DLL：默认全部忽略；发布必需的运行时件用下面的例外保留。
# 例外必须放在通配规则之后，且不能让父目录被忽略，否则无效。
*.dll
# ⚠️ 例外模式**必须带 `**/` 前缀**。gitignore 的规则里只要含 `/`，整条就锚定在
#    .gitignore 所在目录（仓库根），`dinput8-Release/dinput8.dll` 只匹配
#    `<根>/dinput8-Release/dinput8.dll` —— 而真实路径在两层之下，于是例外**静默失效**，
#    文件被上面的 `*.dll` 吞掉。
#    实际后果：2026-09-26 目录改名（LanguageBarrier_rndchs -> LanguageBarrier_chs）时，
#    git 把旧路径记成「删除」、新路径因被忽略而没入库 —— **发布用的 dinput8.dll
#    就这么从仓库里消失了**，而 v1.2 时它一直是被跟踪的。
#    判据：`git ls-files | grep dinput8-Release` 应列出 dinput8.dll 与 VSFilter.dll。
!**/dinput8-Release/dinput8.dll
!**/dinput8-Release/VSFilter.dll
!**/dinput8-Release/languagebarrier/LICENSE
!**/dinput8-Release/languagebarrier/THIRDPARTY.LB.txt
# 链接 xy-vsfilter 用的导入库与运行时 DLL（contrib 下）。同样需要 `**/` 前缀：
# VSFilter.lib 会被上面的 `*.lib` 吞掉，VSFilter.dll 被 `*.dll` 吞掉。
!**/xy-vsfilter/VSFilter.dll
!**/xy-vsfilter/VSFilter.lib
# 代理 DLL：补丁运行必需，来自 CoZ 补丁包（非本项目编译产物），
# 是「从本仓库重建安装包」不可缺的原件。见 补丁数据/README.md
# ⚠️ 路径必须与目录实际位置一致 —— 移动目录后这里要同步改，否则例外失效、
#    VSFilter.dll 会被 *.dll 静默忽略（其余 6 个无扩展名不受影响，所以很容易漏）。
!补丁数据/代理DLL/VSFilter.dll

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Rust (sc3tools) — 构建中间产物
# 注意：不能忽略整个 target/，否则 release exe 的例外规则不生效
sc3tools_chs/target/debug/
sc3tools_chs/target/release/build/
sc3tools_chs/target/release/deps/
sc3tools_chs/target/release/examples/
sc3tools_chs/target/release/incremental/
sc3tools_chs/target/release/.fingerprint/
sc3tools_chs/target/release/*.d
sc3tools_chs/target/release/*.rmeta
sc3tools_chs/target/release/*.rlib
sc3tools_chs/target/release/deps/**/*.rlib
sc3tools_chs/target/release/deps/**/*.exe
*.rmeta
*.rlib

# 例外：发布必需的提取工具（用户不会自行编译 Rust）
!sc3tools_chs/target/release/sc3tools.exe

# cargo 运行时锁与手工备份：不属于发布内容。
# （此前被 `Release/` 那条误伤的规则连带忽略了，修好规则后暴露出来，这里显式排除。）
.cargo-lock
*.bak_*

